# Required. SEC fair-access User-Agent: application name plus a real contact email.
# Example format only — replace with your own contact before live SEC calls.
SEC_USER_AGENT=SEC Filings API your-email@example.com

# Required. Trusted SEC data API base URL (no trailing slash).
SEC_DATA_BASE_URL=https://data.sec.gov

# Required. Trusted SEC Archives base used to build primary document links.
SEC_ARCHIVES_BASE_URL=https://www.sec.gov/Archives/edgar/data

# Required. Outbound SEC request timeout in milliseconds.
SEC_TIMEOUT_MS=10000

# Required. Minimum spacing between outbound SEC requests in milliseconds (<= 10 req/s).
SEC_MIN_REQUEST_INTERVAL_MS=100

# Optional. In-memory SEC response cache TTL in milliseconds (default 300000). Set 0 to disable.
SEC_CACHE_TTL_MS=300000

# Optional. Comma-separated browser origins allowed by CORS (default http://localhost:5173).
CORS_ORIGINS=http://localhost:5173
